      "url": "/?go=target"
    },
    {
      "name": "Suivi des candidatures",
      "short_name": "Suivi",
      "description": "Ce qui avance, ce qui attend, ce qui est mort",
      "url": "/?go=tracking"
    },
    {
      "name": "Assistant d'entretien",
      "short_name": "Live",
      "description": "Les reponses en direct pendant l'entretien",
      "url": "/?go=live"
    }
  ]
