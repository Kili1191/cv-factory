{
  "name": "Nuvi - the CV that gets past the ATS",
  "short_name": "Nuvi",
  "description": "Paste the job ad, get the CV that matches it, and track your applications.",
  "id": "/",
  "start_url": "/app?src=homescreen",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#faf8f3",
  "theme_color": "#faf8f3",
  "lang": "fr",
  "dir": "ltr",
  "categories": [
    "productivity",
    "business"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Coller une annonce",
      "short_name": "Annonce",
      "description": "Adapter le CV a une offre en quelques secondes",
      "url": "/?go=target"
    },
    {
      "name": "Suivi des candidatures",
      "short_name": "Suivi",
      "description": "Ce qui avance, ce qui attend, ce qui est mort",
      "url": "/?go=tracking"
    },
    {
      "name": "Assistant d'entretien",
      "short_name": "Live",
      "description": "Les reponses en direct pendant l'entretien",
      "url": "/?go=live"
    }
  ]
}
